# Environment example

OPENAI_API_KEY=
SLACK_WEBHOOK_URL=

# SMTP (use SendGrid SMTP or any SMTP server)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=onboarding@example.com

# DB (local SQLite - kept for fallback if you want)
DB_FILE=

# Supabase (server-side keys)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
